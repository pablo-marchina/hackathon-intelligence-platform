APP_ENV=development
APP_NAME=hackathon-intelligence-platform
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
DATABASE_URL=postgresql+psycopg://hackathon:hackathon@localhost:5432/hackathon
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hackathon-raw
S3_REGION=us-east-1
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CORS_ORIGINS=http://localhost:3000

# W4 OAuth/session foundation
PUBLIC_API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
AUTH_STATE_SECRET=replace-with-at-least-32-random-bytes
SESSION_COOKIE_NAME=hip_session
CSRF_COOKIE_NAME=hip_csrf
SESSION_TTL_SECONDS=2592000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# W6 diagnostic endpoint. No public unauthenticated live fetches.
# LIVE_SOURCES_GATE_TOKEN=<secret>   # Server side only; required for /api/live_sources
# LIVE_SOURCES_ALLOW_UNMANAGED_FETCH=0 # ONLY local development/test; never staging/production

# W6 scheduler: explicitly opt in only after PostgreSQL migration 0007/staging verification.
SOURCE_SCHEDULER_ENABLED=false
SOURCE_SCHEDULER_BATCH_SIZE=3
SOURCE_SCHEDULER_MAX_PAGES=5

# W6 DR test: NEVER enable outside a local disposable environment / CI.
# APP_ENV=test
# HIP_ALLOW_DR_DB_DRILL=1
# Backup S3 authentication uses S3_ACCESS_KEY / S3_SECRET_KEY above.
# Emergency PostgreSQL-only restore requires HIP_CONFIRM_PG_RESTORE=YES.
# In production it additionally requires HIP_ALLOW_PROD_RESTORE=YES.

# W6 alert outbox (opt-in; NOT enabled by default):
# ALERT_DISPATCH_ENABLED=false
# ALERT_DISPATCH_BATCH_SIZE=25
# ALERT_DISPATCH_CLAIM_SECONDS=180
# Configure SMTP_HOST, SMTP_PORT, SMTP_FROM_ADDRESS, and start Celery worker
# on the default queue before enabling delivery in staging.
# SMTP_STARTTLS=true                 # verified STARTTLS, e.g. port 587
# SMTP_SSL=true                      # verified implicit TLS, e.g. port 465
# SMTP_USERNAME=<username>           # requires exactly one TLS mode enabled
# SMTP_PASSWORD=<secret>             # never put credentials in plaintext SMTP
# Anonymous plaintext SMTP is only suitable for isolated local fake mail servers.

# W6 saved-search matching producer: independent of SMTP relay; disabled by default.
# First enabled run initializes a watermark (no historical backfill).
ALERT_MATCH_ENABLED=false
ALERT_MATCH_BATCH_SIZE=25
ALERT_MATCH_MIN_AGE_SECONDS=60
